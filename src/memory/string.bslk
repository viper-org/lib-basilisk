module std::string;

import std::memory;

func strlen(s: i8*) -> u32 {
    let i = 0;
    while (s[i] != 0) {
        i += 1;
    }
    return i;
}

func strcpy(dest: i8*, src: i8*) -> void {
    let i = 0;
    while (src[i] != 0) {
        dest[i] = src[i];
        i += 1;
    }
}

func strcat(dest: i8*, src: i8*) -> void {
    let i = 0;
    while (dest[i] != 0) {
        i += 1;
    }
    let j = 0;
    while (src[j] != 0) {
        dest[j+i] = src[j];
        j += 1;
    }
}

func strdup(s: i8*) -> i8* {
    let size = strlen(s);
    let mem: i8* = mem_alloc(size+1);
    memcpy(mem, s, size+1);
    return mem;
}