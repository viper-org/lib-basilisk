module std::system::io::file;

import std::windows::file;
import std::windows::handle;

import std::memory;

struct FILE {
    handle: void*;
    seekpos: u32;
}

/*
 * File management functions
 */

func fopen(path: i8*) -> FILE* {
    let ret: FILE* = mem_alloc(sizeof(FILE));
    let handle = CreateFileA(
        path,
        GENERIC_READ | GENERIC_WRITE,
        0,
        nullptr,
        OPEN_ALWAYS,
        FILE_ATTRIBUTE_NORMAL,
        nullptr
    );
    ret->handle = handle;
    ret->seekpos = 0;
    return ret;
}

func fclose(file: FILE*) -> void {
    CloseHandle(file->handle);
    mem_free(file);
}


/*
 * File access functions
 */

func fwrite(file: FILE*, buf: void*, size: usz) -> usz {
    let written: u32 = 0;
    WriteFile(file->handle, buf, size, &written, nullptr);
    file->seekpos += written;
    return written;
}

func fread(file: FILE*, buf: void*, size: usz) -> usz {
    let read: u32 = 0;
    ReadFile(file->handle, buf, size, &read, nullptr);
    file->seekpos += read;
    return read;
}


/*
 * File position functions
 */

const SEEK_SET = 0;
const SEEK_CUR = 1;
const SEEK_END = 2;

func fseek(file: FILE*, off: i32, mode: i32) -> void {
    file->seekpos = SetFilePointer(file->handle, off, nullptr, mode);
}

func frewind(file: FILE*) -> void {
    SetFilePointer(file->handle, 0, nullptr, FILE_BEGIN);
    file->seekpos = 0;
}

func ftell(file: FILE*) -> u32 {
    return file->seekpos;
}