module std::_internals::start;
import std::windows::process::threads;

import std::system::io;
import std::memory;

func main() -> i32;

func _start() -> void {
    // TODO: Get argc and argv from command-line

    system_io_init();
    memory_allocator_init();

    let exitCode = main();
    ExitProcess(exitCode);

    // Unreachable since ExitProcess does not return
}